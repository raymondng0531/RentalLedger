rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request signed in as the Treasurer of [houseId]?
    // Used to gate writes that move money for the house (transactions) — the
    // house document's treasurerId is the source of truth for the role.
    function isHouseTreasurer(houseId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/houses/$(houseId))
          .data.treasurerId == request.auth.uid;
    }

    // Users: read/write own profile only.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Houses: authenticated members can read; creator/treasurer can write.
    // The update rule compares the EXISTING doc's treasurerId (resource.data),
    // so only the current treasurer can edit the house or transfer the role —
    // a member cannot make themselves treasurer by setting treasurerId to their
    // own uid.
    match /houses/{houseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.treasurerId == request.auth.uid;
      allow delete: if false;
    }

    // House members: all authenticated read.
    //
    // create — a user may only write their OWN membership record:
    //   * create-house writes the creator as Treasurer. That is the only path
    //     allowed to self-assign the Treasurer role, and it requires the caller
    //     to already be the house's treasurerId, so a joiner cannot write
    //     themselves a Treasurer record. Role is display state (every money
    //     rule keys off houses.treasurerId), but forging it would misreport the
    //     member list and any role-driven UI.
    //   * join writes the joiner as Member.
    // Both real callers pass the signed-in uid (create_house_page /
    // join_house_page), so requiring userId == auth.uid changes no workflow.
    //
    // update — split by actor:
    //   * A member may only soft-delete their OWN membership (leave). The app
    //     writes exactly {'isActive': false}; `affectedKeys().hasOnly` pins the
    //     write to that single field so the record cannot be used to escalate —
    //     without it a member could rewrite their own `role` to 'Treasurer'.
    //   * The house treasurer keeps full update rights, which the role transfer
    //     (rewrites `role` on two records) and member removal rely on.
    match /house_members/{memberId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.role == 'Member' ||
          (request.resource.data.role == 'Treasurer' &&
            get(/databases/$(database)/documents/houses/$(request.resource.data.houseId))
              .data.treasurerId == request.auth.uid));
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isActive']) &&
          request.resource.data.isActive == false) ||
        get(/databases/$(database)/documents/houses/$(resource.data.houseId))
          .data.treasurerId == request.auth.uid
      );
      allow delete: if false;
    }

    // Expenses: all authenticated read.
    // - Members may create expenses and may edit/delete ONLY their own pending
    //   expenses (title/amount/etc. while it's still awaiting review).
    // - The house treasurer may advance the workflow
    //   (approve / reject / mark paid).
    match /expenses/{expenseId} {
      allow read: if request.auth != null;
      // A claim must be filed under the submitter's own uid and must start its
      // life as 'pending' — a client cannot open an expense already marked
      // approved/paid, which would bypass the Treasurer's review entirely.
      //
      // NOTE: this does NOT yet verify that the caller is a member of
      // `houseId`. Membership is not expressible in rules with the current
      // data model — house_members documents have random UUID ids, and rules
      // can only `get()` a document by path, never query a collection. Closing
      // that needs a membership record addressable by path (see the Phase 2
      // report); until then this rule bounds the damage to a misfiled pending
      // claim in a house the caller cannot read, cannot approve, and cannot
      // move money from.
      allow create: if request.auth != null &&
        request.resource.data.purchasedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (resource.data.purchasedBy == request.auth.uid &&
         resource.data.status == 'pending') ||
        get(/databases/$(database)/documents/houses/$(resource.data.houseId))
          .data.treasurerId == request.auth.uid
      );
      allow delete: if request.auth != null &&
        resource.data.purchasedBy == request.auth.uid &&
        resource.data.status == 'pending';
    }

    // Transactions: authenticated read; ONLY the house Treasurer creates.
    // Deposits, direct payments and reimbursements move the house balance,
    // which is computed from this collection, so letting any signed-in user
    // append a transaction would let a member forge deposits/direct payments.
    // Append-only — no updates or deletes.
    match /transactions/{transactionId} {
      allow read: if request.auth != null;
      allow create: if isHouseTreasurer(request.resource.data.houseId);
      allow update: if false;
      allow delete: if false;
    }

    // Categories: all authenticated read; the house treasurer writes.
    // (The doc id is `<houseId>_<categoryId>` and stores `houseId`.)
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/houses/$(request.resource.data.houseId))
          .data.treasurerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Notifications: any authenticated user may CREATE one, but may only
    // read / mark-read / delete their OWN.
    //
    // create is deliberately NOT restricted to `userId == auth.uid`: the app
    // writes notifications on the acting client for OTHER users (Expense
    // Submitted → Treasurer, Approved/Rejected/Reimbursed → submitter,
    // Remind → Treasurer). Requiring `userId == auth.uid` here silently denied
    // every cross-user notification — the write failed, `createNotification`
    // swallowed the error, and the submitter never saw "Reimbursement
    // Completed" after the Treasurer marked an expense paid.
    //
    // IMPORTANT: `resource` is null on create, so check the INCOMING data
    // (`request.resource.data.userId`) — the old `resource.data.userId` check
    // crashed every create.
    //
    // ── ACCEPTED RISK (reviewed in the Phase 2 security pass) ──
    // `create` being open means any authenticated user can write a
    // notification to any other user. This is deliberately NOT tightened:
    //   * Notifications are non-financial and non-destructive — they carry no
    //     money movement and grant no permission. The only rule that reads
    //     them scopes read/update/delete to `userId == auth.uid`.
    //   * The app has no server-side creator. lib/features/notifications/
    //     data/datasources/notification_remote_datasource.dart writes every
    //     notification from the ACTING client on behalf of OTHER users
    //     (submitted → Treasurer, approved/rejected/reimbursed → submitter,
    //     remind → Treasurer). Requiring `userId == auth.uid` here silently
    //     denied all of those once already, which is why the rule reads the
    //     way it does.
    //   * The notification document carries `type` and `relatedId` but NO
    //     `houseId`, so no house-scoped condition is even expressible today.
    // The residual is a spam/forged-notification vector between authenticated
    // users. The proper fix is to move creation into a Cloud Function (the
    // functions/ project already listens on this collection) or to add
    // `houseId` to the document and gate on it — both are design changes, not
    // rule tweaks, so neither is applied here.
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // App settings: house members read.
    match /app_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bills: authenticated read.
    //
    // Creating, editing and deleting a bill are Treasurer actions in the UI
    // (upcoming_bills_section gates them on `isTreasurer`), so they are gated
    // on houses.treasurerId here too. Before this they were open to every
    // authenticated user, who could rewrite or delete any house's bills by id.
    //
    // update stays reachable for a plain Member on ONE field: the reminder
    // toggle is an explicitly Member-facing control ("The Member-facing bill
    // controls are the reminder toggle and Remind Treasurer"), and toggling it
    // writes exactly {'reminderEnabled': bool}. Pinning the write to that key
    // keeps the member workflow working while reducing what anyone else can do
    // to a bill from "rewrite or delete it" to "flip its reminder flag".
    //
    // The residual (a non-member of the house can still flip that flag) cannot
    // be closed until membership is expressible in rules — see the note on
    // expenses create above. It touches no money and destroys no data.
    match /bills/{billId} {
      allow read: if request.auth != null;
      allow create: if isHouseTreasurer(request.resource.data.houseId);
      allow update: if isHouseTreasurer(resource.data.houseId) ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reminderEnabled']);
      allow delete: if isHouseTreasurer(resource.data.houseId);
    }
  }
}

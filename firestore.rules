rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // MEMBERSHIP AUTHORIZATION
    //
    // `house_members` uses random UUID document ids, and rules can only get()
    // a document BY PATH — never query a collection. So "is this user a member
    // of this house?" used to be inexpressible, and every membership-dependent
    // rule had to stay open.
    //
    // The fix is a second, path-addressable record maintained ONLY by Cloud
    // Functions (see functions/index.js):
    //
    //     houses/{houseId}/members/{userId}  →  { isActive, role }
    //
    // `house_members` remains the historical record and is never rewritten,
    // migrated or deleted. The index answers only "may this user act in this
    // house RIGHT NOW?".
    //
    // CRITICAL: the index is `allow write: if false` for clients. A membership
    // check alone would have closed nothing — under the old rules an attacker
    // could write their own `house_members` row, so any condition the rules
    // could express was satisfiable by the attacker. What makes this work is
    // that the client cannot write the thing the rules read.
    //
    // get() on a missing index document returns null; reading `.data` off null
    // makes the rule error, which DENIES. Failures are therefore closed.
    // ─────────────────────────────────────────────────────────────
    function membershipIndex(houseId) {
      return get(/databases/$(database)/documents/houses/$(houseId)/members/$(request.auth.uid)).data;
    }

    /** Is the caller an ACTIVE member of [houseId]? */
    function isMember(houseId) {
      return request.auth != null && membershipIndex(houseId).isActive == true;
    }

    /**
     * Is the caller the TREASURER of [houseId]?
     *
     * Money operations deliberately keep keying off `houses.treasurerId`, which
     * is the authoritative role and is what the existing Transfer Treasurer
     * flow writes. The index is used for MEMBERSHIP (reads, claim creation);
     * the house document is used for MONEY. Keeping them separate means a
     * transfer takes effect for money immediately, with no window where the
     * incoming Treasurer cannot act.
     */
    function isHouseTreasurer(houseId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/houses/$(houseId))
          .data.treasurerId == request.auth.uid;
    }

    // Users: read/write own profile only.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Houses.
    //
    // read — only a member may read a house, which closes both house
    //   enumeration and the invite-code leak (the code is the join secret).
    //   The Treasurer is additionally allowed by `treasurerId`, which is not a
    //   loophole but the Create House path: the creator writes the house before
    //   their membership row exists, and would otherwise be locked out of the
    //   house they just made until the index sync ran.
    //
    // create — the caller must name THEMSELVES as Treasurer. Previously any
    //   authenticated user could create a house naming someone else, handing
    //   that person Treasurer powers over a house they never made.
    //
    // update — only the current Treasurer. Compares the EXISTING document's
    //   treasurerId, so nobody can promote themselves by writing their own uid.
    match /houses/{houseId} {
      allow read: if isMember(houseId) ||
        (request.auth != null && resource.data.treasurerId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.treasurerId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.treasurerId == request.auth.uid;
      allow delete: if false;

      // The authorization index. Readable by members of the house and by the
      // subject themselves (so a user can see their own state), and writable
      // ONLY by the Admin SDK — Cloud Functions bypass rules entirely, so
      // `write: if false` here does not hinder them.
      match /members/{userId} {
        allow read: if isMember(houseId) || request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Historical membership records.
    //
    // read — a member of the house may read its roster, INCLUDING inactive
    //   rows: historical member-name resolution depends on those. A user may
    //   also read their own rows (which is how `findHouseByUserId` discovers
    //   which house to load at sign-in, and how a removed member can still see
    //   their own history of membership).
    //
    // create — Treasurer rows only, and only for a house the caller is already
    //   treasurerId of. That is exactly the Create House path. MEMBER rows are
    //   now created by the joinHouse callable with admin credentials, so a
    //   client can no longer write itself a membership — which is what made
    //   the old membership gap exploitable.
    //
    // update — split by actor:
    //   * A member may keep their OWN, still-ACTIVE row's display name and
    //     photo in step with their profile. This is the avatar/name
    //     synchronization (`updateMemberDisplayInfo`) the app runs at sign-in
    //     and on profile save — it previously worked for the Treasurer and was
    //     denied for everyone else.
    //     `hasOnly(['displayName', 'photoUrl'])` is the whole security
    //     argument: role, isActive, houseId, userId, memberId, joinedAt and
    //     email all sit outside the set, so this path cannot promote, cannot
    //     reactivate, cannot re-key a row and cannot smuggle in extra fields.
    //     `resource.data.isActive == true` tests the row AS IT EXISTS, so an
    //     inactive row — the historical record of a membership that ended — is
    //     out of reach entirely, and its display name stays what it was.
    //     `size() > 0` requires the write to actually change one of those two
    //     fields, so "set isActive to what it already is" is not an update a
    //     member can perform at all.
    //   * A member may only soft-delete their OWN row (Leave House). Pinning to
    //     `hasOnly(['isActive'])` and `isActive == false` stops the record
    //     being used to escalate; without it a member could rewrite their role.
    //     Being a separate branch, leaving cannot be combined with a profile
    //     change: the two key-sets are disjoint and neither branch admits the
    //     union.
    //   * The house Treasurer keeps full update rights, which Transfer Treasurer
    //     (rewrites `role` on two rows) and Remove Member rely on.
    //
    // cloud functions react to these writes and mirror the result into the
    // authorization index — that is why none of those workflows needed changing.
    match /house_members/{memberId} {
      allow read: if request.auth != null && (
        isMember(resource.data.houseId) ||
        resource.data.userId == request.auth.uid
      );
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.role == 'Treasurer' &&
        get(/databases/$(database)/documents/houses/$(request.resource.data.houseId))
          .data.treasurerId == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.userId == request.auth.uid &&
          resource.data.isActive == true &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoUrl']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .size() > 0) ||
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isActive']) &&
          request.resource.data.isActive == false) ||
        get(/databases/$(database)/documents/houses/$(resource.data.houseId))
          .data.treasurerId == request.auth.uid
      );
      allow delete: if false;
    }

    // Expenses.
    // - Active members read and create; only the Treasurer advances the
    //   workflow (approve / reject / mark paid).
    // - Members may edit/delete ONLY their own pending expense.
    match /expenses/{expenseId} {
      // Membership-scoped, so no member can read another house's claims.
      allow read: if isMember(resource.data.houseId);
      // A claim must be filed by an ACTIVE MEMBER of the target house, under
      // their own uid, and start as 'pending' — a client can neither file in a
      // house it does not belong to, nor file under someone else's name, nor
      // open a claim already approved/paid and bypass review.
      allow create: if isMember(request.resource.data.houseId) &&
        request.resource.data.purchasedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Update is TWO different powers in one rule:
      // - the Treasurer advances the workflow (approve / reject / reimburse /
      //   mark paid), so their branch stays deliberately unconstrained;
      // - the purchaser may correct their OWN claim while it is still pending,
      //   and ONLY within the fields the edit form exposes (title, amount,
      //   description, category, receipt). Every workflow field — status,
      //   purchasedBy, houseId, approvedBy/approvedAt, reimbursedBy, paidAt,
      //   rejectReason, createdAt and any transaction reference — is outside
      //   the allowlist, so a raw SDK write cannot self-approve, self-reject,
      //   self-mark-paid or rewrite the money trail.
      // paymentSource is carried through UNCHANGED by the edit (the datasource
      // always writes it), so it is permitted-but-pinned: re-pointing a claim
      // between personal money and the Central Account stays Treasurer-only.
      allow update: if request.auth != null && (
        (resource.data.purchasedBy == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'title', 'description', 'categoryId', 'amount', 'receiptUrl',
           'paymentSource', 'updatedAt'
         ]) &&
         request.resource.data.get('paymentSource', null) ==
           resource.data.get('paymentSource', null)) ||
        isHouseTreasurer(resource.data.houseId)
      );
      allow delete: if request.auth != null &&
        resource.data.purchasedBy == request.auth.uid &&
        resource.data.status == 'pending';
    }

    // Transactions: member read; ONLY the house Treasurer creates.
    // Deposits, direct payments and reimbursements move the house balance,
    // which is computed from this collection, so letting any signed-in user
    // append a transaction would let a member forge deposits/direct payments.
    // Append-only — no updates or deletes.
    match /transactions/{transactionId} {
      allow read: if isMember(resource.data.houseId);
      allow create: if isHouseTreasurer(request.resource.data.houseId);
      allow update: if false;
      allow delete: if false;
    }

    // Categories: member read; the house treasurer writes.
    // (The doc id is `<houseId>_<categoryId>` and stores `houseId`.)
    match /categories/{categoryId} {
      allow read: if isMember(resource.data.houseId);
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/houses/$(request.resource.data.houseId))
          .data.treasurerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Notifications.
    //
    // read / update / delete are scoped to the recipient, so one user can never
    // read another's notifications. That was already true and is unchanged.
    //
    // create remains deliberately OPEN — an ACCEPTED RISK, reviewed in the
    // Phase 2 security pass and re-confirmed here. It is not an oversight:
    //   * The app has no server-side creator. The acting client writes
    //     notifications on behalf of OTHER users (Expense Submitted →
    //     Treasurer, Approved/Rejected/Reimbursed → submitter, Remind →
    //     Treasurer). Requiring `userId == auth.uid` here silently denied every
    //     cross-user notification — the write failed, createNotification
    //     swallowed the error, and the submitter never saw "Reimbursement
    //     Completed".
    //   * The notification document carries `type` and `relatedId` but NO
    //     `houseId`, so no house-scoped condition is expressible.
    // Residual: a spam/forged-notification vector between authenticated users.
    // It moves no money and grants no permission. Closing it properly means
    // generating notifications server-side (the functions/ project already
    // listens on this collection) or adding `houseId` and gating on membership
    // — both are design changes, deliberately out of scope for this phase.
    //
    // IMPORTANT: `resource` is null on create, so check the INCOMING data
    // (`request.resource.data.userId`) — the old `resource.data.userId` check
    // crashed every create.
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // App settings: signed-in read. Carries no house or personal data.
    match /app_settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bills: member read.
    //
    // Creating, editing and deleting a bill are Treasurer actions in the UI
    // (upcoming_bills_section gates them on `isTreasurer`), so they are gated
    // on houses.treasurerId here too.
    //
    // update stays reachable for a plain Member on ONE field: the reminder
    // toggle is an explicitly Member-facing control, and toggling it writes
    // exactly {'reminderEnabled': bool}. The write is now pinned to that key
    // AND to active membership of that house, so a non-member can no longer
    // flip it (the residual reported in the previous phase).
    match /bills/{billId} {
      allow read: if isMember(resource.data.houseId);
      allow create: if isHouseTreasurer(request.resource.data.houseId);
      allow update: if isHouseTreasurer(resource.data.houseId) ||
        (isMember(resource.data.houseId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reminderEnabled']));
      allow delete: if isHouseTreasurer(resource.data.houseId);
    }
  }
}
